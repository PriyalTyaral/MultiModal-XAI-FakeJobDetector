# LIME Service Environment Variables
# Copy this file to .env and fill in actual values

# Model path (optional — leave blank to use surrogate model)
MODEL_PATH=

# Cache settings
CACHE_MAX_SIZE=500
CACHE_TTL_SECONDS=3600

# LIME settings
LIME_NUM_SAMPLES=500

# Port settings
LIME_SERVICE_PORT=5002

# Server port
PORT=5001

# Google Cloud Platform (optional — leave blank for offline mode)
GCP_PROJECT_ID=
GCP_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=service-account.json
